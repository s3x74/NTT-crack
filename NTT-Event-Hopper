local function teleport(server)
    if not server or not server.JobId then
        setStatus("이 서버의 토큰을 해독하지 못했습니다.")
        return false
    end

    if server.JobId == game.JobId then
        setStatus("이미 현재 서버에 접속 중입니다.")
        return false
    end

    local placeId = getPlaceId(server.Name)

    setStatus("서버 참가 중: " .. server.Name)

    local ok, err = pcall(
        TeleportService.TeleportToPlaceInstance,
        TeleportService,
        placeId,
        server.JobId,
        player
    )

    if not ok then
        setStatus("서버 참가 실패: " .. tostring(err))
        return false
    end

    return true
end

