local function updateTabs()
    for apiName, button in pairs(tabButtons) do
        if apiName == selected.api then
            button.BackgroundColor3 = Color3.fromRGB(65, 104, 168)
        else
            button.BackgroundColor3 = Color3.fromRGB(45, 45, 51)
        end
    end
end

local function findLatestValid(servers)
    for _, server in ipairs(servers) do
        if server.JobId then
            return server
        end
    end
end

local function refresh()
    if refreshing then
        return
    end

    refreshing = true
    refreshSerial = refreshSerial + 1

    local serial = refreshSerial
    local eventAtStart = selected

    setStatus(eventAtStart.name .. " 서버 확인 중...")

    task.spawn(function()
        local servers, err = getServers(eventAtStart.api)

        if serial ~= refreshSerial or eventAtStart.api ~= selected.api then
            refreshing = false
            return
        end

        clearCards()

        if not servers then
            setStatus("API 오류: " .. tostring(err))
            refreshing = false
            return
        end

        local latest = findLatestValid(servers)
        local validCount = 0
        local latestMarked = false

        for i, server in ipairs(servers) do
            if server.JobId then
                validCount = validCount + 1
            end

            local isLatest = false
            if latest and not latestMarked and server.JobId == latest.JobId then
                isLatest = true
                latestMarked = true
            end

            createCard(server, i, isLatest)
        end

        if #servers == 0 then
            setStatus(eventAtStart.name .. " · 현재 서버 없음")
        else
            setStatus(
                eventAtStart.name
                .. " · "
                .. #servers
                .. "개 / 정상 "
                .. validCount
                .. "개"
            )
        end

        refreshing = false

        if autoJoin and latest and latest.JobId ~= game.JobId then
            local now = os.clock()

            if latest.JobId ~= lastAutoTarget or now - lastAutoAttempt >= 12 then
                lastAutoTarget = latest.JobId
                lastAutoAttempt = now

                task.delay(0.15, function()
                    if autoJoin and selected.api == eventAtStart.api then
                        teleport(latest)
                    end
                end)
            end
        end
    end)
end

