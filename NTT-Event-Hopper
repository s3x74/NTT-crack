local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function bxor(a, b)
    if bit32 and bit32.bxor then
        return bit32.bxor(a, b)
    end

    local out, p = 0, 1
    while a > 0 or b > 0 do
        local aa = a % 2
        local bb = b % 2
        if aa ~= bb then
            out = out + p
        end
        a = math.floor(a / 2)
        b = math.floor(b / 2)
        p = p * 2
    end
    return out
end

local function base64Decode(data)
    data = data:gsub("%s", "")

    if #data % 4 == 1 then
        return nil
    end

    while #data % 4 ~= 0 do
        data = data .. "="
    end

    local out = {}

    local function value(ch)
        if ch == "=" then
            return nil
        end

        local i = B64:find(ch, 1, true)
        if not i then
            return false
        end

        return i - 1
    end

    for i = 1, #data, 4 do
        local a = value(data:sub(i, i))
        local b = value(data:sub(i + 1, i + 1))
        local c = value(data:sub(i + 2, i + 2))
        local d = value(data:sub(i + 3, i + 3))

        if a == false or b == false or c == false or d == false then
            return nil
        end

        if a == nil or b == nil then
            return nil
        end

        local n = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)

        out[#out + 1] = string.char(math.floor(n / 65536) % 256)

        if c ~= nil then
            out[#out + 1] = string.char(math.floor(n / 256) % 256)
        end

        if d ~= nil then
            out[#out + 1] = string.char(n % 256)
        end
    end

    return table.concat(out)
end

local function validJobId(id)
    return type(id) == "string"
        and #id == 36
        and id:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
end

local function decodeNTT(token)
    if type(token) ~= "string" then
        return nil
    end

    token = token:gsub("^NTT_", ""):gsub("%s", "")

    local raw = base64Decode(token)
    if not raw then
        return nil
    end

    local out = {}

    for i = 1, #raw do
        local keyByte = XOR_KEY:byte(((i - 1) % #XOR_KEY) + 1)
        out[i] = string.char(bxor(raw:byte(i), keyByte))
    end

    local jobId = table.concat(out)
    if not validJobId(jobId) then
        return nil
    end

    return jobId
end

local function getServers(eventId)
    local url = API .. HttpService:UrlEncode(eventId)
    local ok, body = pcall(game.HttpGet, game, url)

    if not ok then
        return nil, tostring(body)
    end

    local servers = {}
    local seen = {}

    for entry in body:gmatch('"(.-)"') do
        local serverName, token = entry:match("^(.-)%s*||%s*(NTT_.+)$")

        if serverName and token then
            token = token:match("^%s*(.-)%s*$")
            local jobId = decodeNTT(token)
            local key = jobId or token

            if not seen[key] then
                seen[key] = true
                servers[#servers + 1] = {
                    Name = serverName,
                    Token = token,
                    JobId = jobId
                }
            end
        end
    end

    return servers
end

local function getPlaceId(serverName)
    if serverName:find("Sea 2", 1, true) then
        return PLACE_IDS.Sea2
    end

    if serverName:find("Sea 3", 1, true)
        or serverName:find("ThirdSea", 1, true) then
        return PLACE_IDS.Sea3
    end

    return game.PlaceId
end

